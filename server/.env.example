# Copy to .env for local development. Never commit real values.

# Database: either DATABASE_URL or the DB_* variables (DATABASE_URL wins).
DATABASE_URL=postgres://postgres@localhost:5432/twoinside_dev
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_NAME=twoinside_dev
# DB_SSL=false                       # SSL is on by default when NODE_ENV=production
# DB_SSL_REJECT_UNAUTHORIZED=false   # set to true (and DB_SSL_CA) when the provider CA is available

# Frontend origin(s) allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:3000

# Encryption key for device unlock PIN/pattern: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in a password manager: if it is lost, stored codes cannot be read.
DEVICE_SECRET_KEY=
DEVICE_SECRET_KEY_ID=v1
# DEVICE_SECRET_OLD_KEYS=v0:base64...   # previous keys during a rotation
# DEVICE_SECRET_RETENTION_DAYS=7        # days kept after the last order is delivered/cancelled

# Sessions
# SESSION_IDLE_HOURS=12
# SESSION_ABSOLUTE_DAYS=7
# COOKIE_SECURE=false                   # only for plain-http local development

# Proxies in front of the app (Render = 1; Render behind the Vercel rewrite = 2).
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_PER_MINUTE=300

# First SUPER_ADMIN on hosts without a shell; ignored once one exists. Remove after first login.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_PASSWORD=                # temporary, 12+ characters

# Recover a SUPER_ADMIN who forgot the password (applied once per value). Remove after use.
# ADMIN_RESET_EMAIL=
# ADMIN_RESET_PASSWORD=                  # temporary, 12+ characters

# "Forgot password" by email. Unset = feature hidden. Render free blocks SMTP, so use an HTTP API.
# EMAIL_PROVIDER=resend                  # resend | log (log = print to console, local only)
# RESEND_API_KEY=
# EMAIL_FROM="Kenova <no-reply@your-domain>"   # must be a domain verified in Resend
# APP_URL=https://kenova-erp-sooty.vercel.app  # frontend origin used to build the link
# PASSWORD_RESET_TTL_MINUTES=30

GEMINI_API_KEY=
PORT=4000
